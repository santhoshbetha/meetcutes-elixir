# Copy this file to `.kamal/secrets` and replace every placeholder.
# `.kamal/secrets` is a local shell fragment evaluated by Kamal; never commit it.
#
# Prefer pulling values from a password manager or an environment variable,
# for example: SECRET_KEY_BASE=$(op read "op://Meetcutes/production/secret_key_base")

KAMAL_REGISTRY_PASSWORD='replace-with-a-github-container-registry-token'

# Postgres connection string. Keep `sslmode=require` for hosted databases.
DATABASE_URL='ecto://USER:PASSWORD@db.example.com:5432/meetcutes_prod?sslmode=require'

# Generate with `mix phx.gen.secret`.
SECRET_KEY_BASE='replace-with-a-64-byte-random-secret'

# Phoenix LiveDashboard operator account (required in production).
DASHBOARD_USER='admin'
DASHBOARD_PASSWORD='replace-with-a-long-random-password'

# Stripe membership billing.
STRIPE_SECRET_KEY='sk_live_replace_me'
STRIPE_WEBHOOK_SECRET='whsec_replace_me'

# Resend transactional email.
RESEND_API_KEY='re_replace_me'

# MCP administrative command API.
MCP_ADMIN_SECRET_KEY='replace-with-a-long-random-secret'

# Cloudflare R2 / S3-compatible object storage.
AWS_ACCESS_KEY_ID='replace-me'
AWS_SECRET_ACCESS_KEY='replace-me'
CLOUDFLARE_ACCOUNT_ID='replace-me'
