# Version control and local metadata
.git
.gitignore
.DS_Store
Thumbs.db
.vscode
.idea

# Build artifacts and local state are rebuilt inside the image.
_build
.elixir_ls
cover
deps
doc
tmp
erl_crash.dump

# Digested static files are regenerated by `mix assets.deploy`.
priv/static/assets
priv/static/cache_manifest.json
priv/static/*.gz
priv/static/*-*.*

# Test sources and E2E helpers are not part of the production release.
test
priv/e2e

# Never send local credentials or environment files into the build context.
.env
.env.*
.kamal
.kamal/secrets

# Docs, agent notes, and local MCP definitions are not runtime dependencies.
README.md
DEPLOYMENT.md
AGENTS.md
mcp-config.json
