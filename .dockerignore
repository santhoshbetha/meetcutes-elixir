# Build artifacts and local state are rebuilt inside the image.
/_build/
/.elixir_ls/
/cover/
/deps/
/doc/
/tmp/
/erl_crash.dump

# Digested static files are regenerated by `mix assets.deploy` in the builder.
/priv/static/assets/
/priv/static/cache_manifest.json
/priv/static/*.gz
/priv/static/*-*.*

# Test sources are not part of the production release.
/test/

# Never send local credentials or environment files into the build context.
.env
.env.*
!.env.example
.kamal/

# Local editor / OS metadata.
.DS_Store
Thumbs.db
.vscode/
.idea/
