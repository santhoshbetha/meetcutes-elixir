# Development Environment Variables
# Copy this file to .env and update the values as needed

# Frontend URL for generating links in emails and redirects
# In development: defaults to http://localhost:3000
# In production: set via shell environment variable
FRONTEND_URL=http://localhost:5173

# Database Configuration
# Uses the default development database settings
DATABASE_URL=ecto://postgres:postgres@localhost/meetcutes_dev

# AWS S3 / Cloudflare R2 Configuration (Optional for development)
# For Cloudflare R2, use your R2 credentials and endpoint
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_S3_BUCKET=meetcutes-dev-images
AWS_REGION=us-east-1
AWS_S3_HOST=s3.amazonaws.com
AWS_S3_SCHEME=https://
AWS_S3_ASSET_HOST=https://your-custom-domain.com
AWS_S3_PORT=443

R2_SECRET_ACCESS_KEY=dev_secret_key_placeholder
R2_ACCESS_KEY_ID=dev_access_key_placeholder

# Phoenix Server Port (optional - defaults to 4000)
PORT=4000

# Search API rate limiter (token bucket, dual IP + user keys)
RATE_LIMIT_ENABLED=true

# Runtime operational toggles (read by config/runtime.exs, no rebuild needed)
# Set PAYMENT_FEATURE_ENABLED=false to bypass premium gates during promos or
# payment-provider outages. Defaults to true when unset.
PAYMENT_FEATURE_ENABLED=true
# Set MAINTENANCE_MODE_ACTIVE=true to route the frontend to the maintenance page.
MAINTENANCE_MODE_ACTIVE=false

# High-entropy bearer secret for the MCP administrative command API.
# Required to call POST /api/v1/admin/mcp-action via X-MCP-Admin-Key.
MCP_ADMIN_SECRET_KEY=replace_with_a_long_random_secret

# Phoenix LiveDashboard operator credentials (required in production)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change_me_before_production

# Static Authentication Token for API access (development only)
# WARNING: This is insecure - use proper authentication in production
STATIC_AUTH_TOKEN=dev-token-12345

# SMTP Configuration (choose one provider)
# Set SMTP_PROVIDER to specify which provider to use: "resend", "gmail", or "mailgun"
SMTP_PROVIDER=resend

# Resend SMTP Configuration
RESEND_API_KEY=your_resend_api_key_here

# Stripe annual membership billing
# The checkout amount comes from each user's accepted_onetime_fees_amount
# (whole dollars); these values configure the gateway and redirects.
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# Optional overrides; defaults to FRONTEND_URL/dashboard?payment=success|cancelled
# STRIPE_SUCCESS_URL=https://app.meetcutes.us/dashboard?payment=success
# STRIPE_CANCEL_URL=https://app.meetcutes.us/dashboard?payment=cancelled
# Defaults to FRONTEND_URL/dashboard?tab=settings
# STRIPE_PORTAL_RETURN_URL=https://app.meetcutes.us/dashboard?tab=settings
# Set to "local" to skip R2 invoice uploads during local/E2E runs.
# INVOICE_STORAGE=local

# Gmail SMTP Configuration
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password_here

# Mailgun SMTP Configuration
MAILGUN_SMTP_USERNAME=postmaster@your-domain.mailgun.org
MAILGUN_SMTP_PASSWORD=your_mailgun_smtp_password_here

# Other development-specific settings can be added here

# ---------------------------------------------------------------------------
# Production / self-hosted (Coolify, Kamal, Docker) runtime variables
# ---------------------------------------------------------------------------
# These are read by config/runtime.exs when MIX_ENV=prod. Do not commit real
# secrets; inject them through your platform's secret store.

# Required: signs cookies/tokens. Generate with `mix phx.gen.secret`.
# SECRET_KEY_BASE=replace_me

# Public host used for generated URLs (defaults to meetcutes.us).
# PHX_HOST=app.meetcutes.us

# Public URL scheme/port. The container can still listen on an internal PORT.
# PHX_URL_SCHEME=https
# PHX_URL_PORT=443

# Force TLS on the database connection. When omitted, `sslmode=require` in
# DATABASE_URL enables it automatically.
# DATABASE_SSL=true

# Comma-separated browser origins allowed to call the API and open the socket.
# CORS_ORIGINS=https://app.meetcutes.us,https://meetcutes.us

# Database pool and IPv6 options.
# DATABASE_POOL_SIZE takes precedence over the legacy POOL_SIZE variable.
# DATABASE_POOL_SIZE=10
# POOL_SIZE=10
# ECTO_IPV6=true

# Oban queue concurrency for a single-container deployment.
# OBAN_DEFAULT_CONCURRENCY=10
# OBAN_EVENTS_CONCURRENCY=5
# OBAN_MAILER_CONCURRENCY=5

# Enable the HTTP server in releases (`mix release`).
# PHX_SERVER=true

# White-labeled transactional sender. Defaults to noreply@meetcutes.us.
# MAIL_FROM_EMAIL=noreply@meetcutes.us